# =============================================================================
# Variables de entorno — Sistema de Farmacia
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Zona horaria de la farmacia (define "hoy" para caducidades y reportes)
APP_TIMEZONE=America/Mexico_City

# --- Base de datos (desarrollo local) ----------------------------------------
DATABASE_URL=postgresql://farmacia:CAMBIAR_PASSWORD@localhost:5432/farmacia?schema=public
# Base de datos para pruebas automatizadas (debe contener "test" en el nombre)
TEST_DATABASE_URL=postgresql://farmacia:CAMBIAR_PASSWORD@localhost:5432/farmacia_test?schema=public

# --- Docker Compose ----------------------------------------------------------
POSTGRES_DB=farmacia
POSTGRES_USER=farmacia
POSTGRES_PASSWORD=
WEB_PORT=8080

# --- Seguridad ---------------------------------------------------------------
# Secreto para firmar los access tokens (mínimo 32 caracteres, aleatorio).
# Generar con:  openssl rand -hex 32
JWT_ACCESS_SECRET=
# Duración del access token en segundos (15 min)
JWT_ACCESS_TTL_SECONDS=900
# Duración de la sesión con "Recordarme" (días) y sin él (horas)
REFRESH_TTL_REMEMBER_DAYS=30
REFRESH_TTL_SESSION_HOURS=12
# Bloqueo de cuenta tras intentos fallidos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_ENABLED=true

# URL pública del frontend (enlaces de recuperación de contraseña)
APP_URL=http://localhost:5173
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173
# Cookies sólo por HTTPS. Por defecto: true en producción, false en desarrollo.
# COOKIE_SECURE=true
# Número de proxies de confianza (1 detrás de nginx). "false" sin proxy.
TRUST_PROXY=false

# Carpeta de imágenes de productos (relativa a apps/api o absoluta)
UPLOAD_DIR=uploads

# --- Correo (recuperación de contraseña) -------------------------------------
# Sin SMTP_HOST el enlace se escribe en el log del servidor (sólo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Farmacia <no-reply@tu-dominio.com>

# --- Usuario propietario inicial (seed) --------------------------------------
# Si no defines la contraseña, el seed genera una aleatoria y la muestra una vez.
SEED_OWNER_EMAIL=doctor@tu-farmacia.com
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=Doctor
SEED_OWNER_LAST_NAME=Propietario

# --- Respaldos ---------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Contraseña de los usuarios de demostración (npm run db:seed:demo). Sólo desarrollo.
SEED_DEMO_PASSWORD=
